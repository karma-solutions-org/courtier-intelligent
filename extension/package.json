{
  "name": "courtier-intelligent-extension",
  "version": "0.1.0",
  "description": "Courtier Intelligent – Remplissage auto : extension Chrome MV3 qui remplit les extranets des assureurs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "build:emulators": "node build.js --emulators",
    "watch": "node build.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:extranet": "npx --yes http-server@14.1.1 demo-extranet -p 8090 -c-1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  }
}
