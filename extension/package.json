{
  "name": "courtier-intelligent-extension",
  "version": "0.1.0",
  "description": "Courtier Intelligent – Remplissage auto : extension Chrome MV3 qui remplit les extranets des assureurs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "build:emulators": "node build.js --emulators",
    "build:demo": "node build.js --demo",
    "watch": "node build.js --watch --demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:extranet": "npx --yes http-server@14.1.1 demo-extranet -p 8090 -c-1",
    "demo:horizon": "npx --yes http-server@14.1.1 demo-extranet-horizon -p 8091 -c-1",
    "demo:atlas": "npx --yes http-server@14.1.1 demo-extranet-atlas -p 8092 -c-1",
    "demo:oyat": "npx --yes http-server@14.1.1 demo-extranet-oyat -p 8093 -c-1",
    "demo:zephir": "npx --yes http-server@14.1.1 demo-extranet-zephir -p 8094 -c-1",
    "demo:all": "node scripts/demo-all.mjs",
    "extranet:new": "node scripts/new-extranet.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "firebase": "^12.19.0"
  }
}
