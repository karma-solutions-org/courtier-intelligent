{
  "manifest_version": 3,
  "name": "Courtier Intelligent – Remplissage auto",
  "short_name": "Courtier Intelligent",
  "version": "0.1.0",
  "description": "Remplit les extranets des assureurs à partir des dossiers Courtier Intelligent.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Courtier Intelligent"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:4200/*",
      "https://courtier-intelligent-test.web.app/*",
      "https://courtier-intelligent-test.firebaseapp.com/*"
    ]
  }
}
