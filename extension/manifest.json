{
  "manifest_version": 3,
  "name": "Courtier Intelligent – Remplissage auto",
  "short_name": "Courtier Intelligent",
  "version": "0.1.0",
  "description": "Remplit les extranets des assureurs à partir des dossiers Courtier Intelligent.",
  "minimum_chrome_version": "116",
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Courtier Intelligent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:4200/*",
      "http://127.0.0.1:4200/*",
      "https://courtier-intelligent-test.web.app/*",
      "https://courtier-intelligent-test.firebaseapp.com/*"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "alarms",
    "scripting"
  ]
}
